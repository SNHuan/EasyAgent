# EasyAgent local environment example.
#
# Copy this file to .env for local development if you want python-dotenv to
# load these variables through easyagent.config.base.

# ── Claude Code SDK / Claude Code CLI ──────────────────────────────────────
# Claude Code SDK uses Claude Code's normal auth chain.
# Option A: set ANTHROPIC_API_KEY for API-key auth.
# Option B: leave ANTHROPIC_API_KEY unset and run `claude login` first.
# ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: route Claude Code through an Anthropic-compatible gateway/proxy.
# Leave unset when using the default Anthropic endpoint.
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-gateway

# Optional: select the Claude Code model.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: smaller/faster model used by Claude Code for lightweight tasks.
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001

# ── OpenAI Codex SDK / OpenAI APIs ──────────────────────────────────────────
# Codex SDK should follow Codex/OpenAI's normal auth chain.
# Option A: set OPENAI_API_KEY for direct API-key auth.
# Option B: leave OPENAI_API_KEY unset and reuse Codex CLI/app login state.
# OPENAI_API_KEY=sk-your-openai-key

# Optional: route OpenAI-compatible calls through a gateway/proxy.
# OPENAI_BASE_URL=https://your-openai-compatible-gateway/v1

# Optional: model used for direct OpenAI/Codex SDK calls.
# OPENAI_MODEL=gpt-5.4

# Codex stores local state under CODEX_HOME. If CODEX_HOME is unset, Codex
# defaults to ~/.codex. File-based credentials live at CODEX_HOME/auth.json,
# so the default auth file path is ~/.codex/auth.json.
# CODEX_HOME=~/.codex
